  "_knownSheetGaps": {
    "pt": "Casos em que a planilha esta errada e o site esta certo. O verificador ignora estes e os lista como 'corrigido'.",
    "en": "Cases where the spreadsheet is wrong and the site is right. The checker skips these and lists them as 'fixed'.",
    "gaps": [
      {
        "category": "costume",
        "regions": ["Hisui", "Paldea"],
        "fields": ["caught", "released"],
        "why": "As linhas Hisui e Paldea do Resumo nao tem as formulas de Fantasia (colunas AW-AZ vazias), entao 4 entradas com traje nunca foram contadas."
      },
      {
        "category": "dmaxShiny",
        "regions": ["Galar"],
        "fields": ["released"],
        "why": "A formula do Resumo para Dinamax brilhante usava a data de Dinamax normal (coluna V) em vez da de Dinamax brilhante (W) — contava Scorbunny/Raboot/Cinderace/Kubfu/Urshifu (as duas formas) como lancados mesmo sem brilhante ainda. O site usa a data certa (categories.json: gate 'dmaxShiny')."
      },
      {
        "category": "gmaxShiny",
        "regions": ["Galar"],
        "fields": ["released"],
        "why": "Mesma causa do Dinamax brilhante: a formula do Resumo para Gigamax brilhante usava a data do Gigamax normal em vez da do Gigamax brilhante — contava Cinderace-Gmax e Inteleon-Gmax como lancados mesmo sem brilhante ainda. O site usa a data certa (categories.json: gate 'shiny')."
      }
    ]
  },

